# ── Data files ────────────────────────────────────────────────────────────────
*.csv
*.zip

# Allow Excel files ONLY in Databases/
*.xlsx
*.xls
!Databases/**/*.xlsx
!Databases/**/*.xls

# Exclude large binary GIS files
Databases/Shapefiles/

# Exclude Excel temp/lock files
~$*.xlsx
~$*.xls

# ── Docs ─────────────────────────────────────────────────────────────────────
*.md
!README.md

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
